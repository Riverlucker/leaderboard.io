{
  "name": "leaderboard.sc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/check-lint.mjs",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "db:preflight": "tsx scripts/db-preflight.ts",
    "lint:all": "eslint src tests scripts vitest.config.mts",
    "db:backup": "tsx scripts/backup-database.ts",
    "db:verify-backup": "tsx scripts/verify-backup.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "test:smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.22.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
